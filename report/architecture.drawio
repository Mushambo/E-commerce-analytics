<mxfile host="app.diagrams.net"><diagram name="Architecture" id="arch"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1620" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="docker" value="&lt;b&gt;Docker Desktop  ·  docker compose up -d --build&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f2f6fe;strokeColor=#1d63ed;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontColor=#1b1b1a;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1550" height="115" as="geometry"/></mxCell><mxCell id="spark" value="&lt;b&gt;Apache Spark  (PySpark)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf1e8;strokeColor=#d9601a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontColor=#1b1b1a;" vertex="1" parent="1"><mxGeometry x="860" y="80" width="420" height="630" as="geometry"/></mxCell><mxCell id="gen" value="&lt;b&gt;1. Data generation&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;dataset_generator.py&lt;br&gt;(seeded, streamed, --scale)&lt;br&gt;&lt;br&gt;users.json&lt;br&gt;products.json&lt;br&gt;categories.json&lt;br&gt;transactions.json&lt;br&gt;sessions_0..N.json&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#6b6a66;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontColor=#1b1b1a;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="220" height="330" as="geometry"/></mxCell><mxCell id="mongo" value="&lt;b&gt;MongoDB  ·  document store&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;categories  - subcategories embedded&lt;br&gt;products  - extended ref + price_history&lt;br&gt;transactions  - line items embedded&lt;br&gt;users  - computed purchase_summary&lt;br&gt;sessions  - sample of full journeys&lt;br&gt;&lt;br&gt;Indexes: user_id+timestamp, timestamp,&lt;br&gt;items.product_id, total_spent&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eaf6ee;strokeColor=#1f8a4c;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontColor=#1b1b1a;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="390" height="270" as="geometry"/></mxCell><mxCell id="hbase" value="&lt;b&gt;HBase  ·  wide-column store&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;user_sessions&lt;br&gt;key: user_id | reverse_ts | session_id&lt;br&gt;CF: info · pv · cart&lt;br&gt;&lt;br&gt;product_metrics&lt;br&gt;key: product_id | yyyymmdd   CF: m&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecea;strokeColor=#b8322b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontColor=#1b1b1a;" vertex="1" parent="1"><mxGeometry x="380" y="380" width="390" height="200" as="geometry"/></mxCell><mxCell id="lake" value="&lt;b&gt;Parquet data lake  (data/clean)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;9 clean tables, Snappy, partitioned by date&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#6b6a66;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;fontColor=#1b1b1a;" vertex="1" parent="1"><mxGeometry x="380" y="610" width="390" height="100" as="geometry"/></mxCell><mxCell id="s01" value="&lt;b&gt;01  clean &amp;amp; normalise&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;explicit schemas · dedupe · repair · flag&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9601a;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;fontColor=#1b1b1a;" vertex="1" parent="1"><mxGeometry x="885" y="125" width="370" height="62" as="geometry"/></mxCell><mxCell id="s02" value="&lt;b&gt;02  recommendations&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;bought / viewed together, lift&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9601a;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;fontColor=#1b1b1a;" vertex="1" parent="1"><mxGeometry x="885" y="200" width="370" height="50" as="geometry"/></mxCell><mxCell id="s03" value="&lt;b&gt;03  cohort analysis&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;registration-month retention&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9601a;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;fontColor=#1b1b1a;" vertex="1" parent="1"><mxGeometry x="885" y="263" width="370" height="50" as="geometry"/></mxCell><mxCell id="s04" value="&lt;b&gt;04  Spark SQL&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;windows, ROLLUP, Mongo/HBase-shaped joins&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9601a;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;fontColor=#1b1b1a;" vertex="1" parent="1"><mxGeometry x="885" y="326" width="370" height="50" as="geometry"/></mxCell><mxCell id="src" value="&lt;b&gt;integration/sources.py&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;same DataFrame from files | mongo | hbase&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=2;verticalAlign=middle;align=center;spacingLeft=10;fontColor=#1b1b1a;" vertex="1" parent="1"><mxGeometry x="885" y="410" width="370" height="70" as="geometry"/></mxCell><mxCell id="clv" value="&lt;b&gt;CLV + RFM&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;clv_analysis.py&lt;br&gt;&lt;br&gt;users + orders&lt;br&gt;(MongoDB)&lt;br&gt;+ engagement&lt;br&gt;(HBase)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=2;verticalAlign=middle;align=center;spacingLeft=10;fontColor=#1b1b1a;" vertex="1" parent="1"><mxGeometry x="885" y="505" width="180" height="180" as="geometry"/></mxCell><mxCell id="fun" value="&lt;b&gt;Funnel&lt;/b&gt;&lt;b